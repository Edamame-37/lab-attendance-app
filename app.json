{
  "expo": {
    "name": "ppk-mobile-praktikum",
    "slug": "ppk-mobile-praktikum",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edamame.labattendance"
    },
    "android": {
      "package": "com.edamame.labattendance",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "scheme": "ppk-mobile",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBt-L7PnvZ2fmDzGNE-rVaBwQW0Othc8K8"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikasi membutuhkan lokasi untuk menampilkan posisi pengguna dan memvalidasi lokasi laboratorium."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/a937d8b0-1a28-45c4-8b57-25484df719d1"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a937d8b0-1a28-45c4-8b57-25484df719d1"
      }
    },
    "owner": "edamame-37s-team"
  }
}
