
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mengecek apakah pengguna sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Mengecek apakah pengguna mengakses dokumennya sendiri
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Mengecek apakah dokumen profil pengguna tersedia
    function userExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Mengambil profil pengguna yang sedang login
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Mengecek apakah pengguna memiliki role Asisten
    function isAsisten() {
      return userExists() && getUserData().role == 'asisten';
    }

    // ATURAN KOLEKSI USERS
    match /users/{userId} {
      // Pengguna hanya membaca profil sendiri, Asisten dapat membaca semua profil
      allow read: if isOwner(userId) || isAsisten();

      // Registrasi hanya boleh membuat profil Praktikan milik sendiri
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'praktikan';

      // Pengguna hanya boleh mengubah data profil, bukan UID atau role
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nama', 'nomorInduk', 'kelas', 'updatedAt']);

      // Penghapusan profil tidak diizinkan melalui aplikasi
      allow delete: if false;
    }

    // ATURAN KOLEKSI SESSIONS
    match /sessions/{sessionId} {
      // Pengguna yang login dapat melihat sesi praktikum
      allow read: if isAuthenticated();

      // Hanya Asisten yang dapat mengelola sesi praktikum
      allow create, update, delete: if isAsisten();
    }

    // ATURAN KOLEKSI ATTENDANCES
    match /attendances/{attendanceId} {
      // Praktikan membaca presensi sendiri, Asisten membaca semua presensi
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.praktikanId == request.auth.uid ||
        isAsisten()
      );

      // Praktikan hanya dapat membuat presensi atas namanya sendiri
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.praktikanId == request.auth.uid
      );

      // Hanya Asisten yang dapat mengubah atau menghapus presensi
      allow update, delete: if isAsisten();
    }

    // ATURAN KOLEKSI LEAVE REQUESTS
    match /leave_requests/{requestId} {
      // Praktikan membaca pengajuan sendiri, Asisten membaca semua pengajuan
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.praktikanId == request.auth.uid ||
        isAsisten()
      );

      // Praktikan hanya dapat mengajukan izin sendiri dengan status awal pending
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'studentId',
          'studentName',
          'studentNim',
          'sessionId',
          'sessionName',
          'reason',
          'status',
          'createdAt'
        ]);

      // Hanya Asisten yang dapat memproses pengajuan yang masih pending
      allow update: if isAsisten()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy', 'reviewedAt']);

      // Hanya Asisten yang dapat menghapus pengajuan
      allow delete: if isAsisten();
    }
  }
}
