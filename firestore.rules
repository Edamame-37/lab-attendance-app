rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return userExists() && getUserData().get('accountStatus', 'active') == 'active';
    }

    function hasRole(role) {
      return isActiveUser() && (
        getUserData().get('role', '') == role ||
        (getUserData().get('roles', []) is list && role in getUserData().get('roles', []))
      );
    }

    function isAsisten() {
      return hasRole('asisten');
    }

    function isAslab() {
      return hasRole('aslab');
    }

    function isPraktikan() {
      return hasRole('praktikan');
    }

    function validUserData(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'nama',
          'nomorInduk',
          'role',
          'roles',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'nama',
          'nomorInduk',
          'kelas',
          'role',
          'roles',
          'accountStatus',
          'assignedLabIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid == userId &&
        data.uid is string &&
        data.email is string &&
        data.nama is string &&
        data.nama.size() >= 2 &&
        data.nama.size() <= 100 &&
        data.nomorInduk is string &&
        data.nomorInduk.size() >= 3 &&
        data.role in ['praktikan', 'asisten', 'aslab'] &&
        data.roles is list &&
        data.roles.size() >= 1 &&
        data.roles.size() <= 3 &&
        data.role in data.roles &&
        (('praktikan' in data.roles &&
            data.get('kelas', '') is string &&
            data.get('kelas', '').size() > 0) ||
          (!('praktikan' in data.roles) &&
            (data.get('kelas', '') is string || data.get('kelas', null) == null))) &&
        data.accountStatus in ['active', 'suspended'] &&
        data.get('assignedLabIds', []) is list &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function labExistsAndActive(labId) {
      return labId is string &&
        exists(/databases/$(database)/documents/labs/$(labId)) &&
        get(/databases/$(database)/documents/labs/$(labId)).data.isActive == true;
    }

    function validLabData(data) {
      return data.keys().hasAll([
          'name',
          'code',
          'location',
          'radiusMeters',
          'isActive',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'name',
          'code',
          'courseCode',
          'courseName',
          'location',
          'radiusMeters',
          'gracePeriodMinutes',
          'lateFineAmount',
          'address',
          'aslabId',
          'asprakIds',
          'asprakMembers',
          'studentIds',
          'studentMembers',
          'isActive',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.name is string &&
        data.code is string &&
        data.get('courseCode', '') is string &&
        data.get('courseName', '') is string &&
        data.location is latlng &&
        data.radiusMeters is number &&
        data.radiusMeters > 0 &&
        data.get('gracePeriodMinutes', 15) is number &&
        data.get('gracePeriodMinutes', 15) >= 0 &&
        data.get('lateFineAmount', 10000) is number &&
        data.get('lateFineAmount', 10000) >= 0 &&
        data.get('address', '') is string &&
        data.get('aslabId', '') is string &&
        data.get('asprakIds', []) is list &&
        data.get('asprakMembers', []) is list &&
        data.get('studentIds', []) is list &&
        data.get('studentMembers', []) is list &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedBy == request.auth.uid;
    }

    function validNewLabData(data) {
      return data.keys().hasAll([
          'courseCode',
          'courseName',
          'gracePeriodMinutes',
          'lateFineAmount',
          'aslabId',
          'asprakIds',
          'asprakMembers',
          'studentIds',
          'studentMembers'
        ]) &&
        data.aslabId == request.auth.uid;
    }

    function canManageSessionLab(labId) {
      return isAsisten() &&
        labId is string &&
        exists(/databases/$(database)/documents/labs/$(labId)) &&
        get(/databases/$(database)/documents/labs/$(labId)).data.get('asprakIds', []) is list &&
        (get(/databases/$(database)/documents/labs/$(labId)).data.get('asprakIds', []).size() == 0 ||
          request.auth.uid in get(/databases/$(database)/documents/labs/$(labId)).data.get('asprakIds', []));
    }

    function validSessionData(data) {
      return data.keys().hasAll([
          'kodeMataKuliah',
          'namaPraktikum',
          'topikMateri',
          'kelas',
          'labId',
          'ruangLab',
          'hari',
          'jamMulai',
          'jamSelesai',
          'namaAsisten',
          'asistenId',
          'status',
          'statusSesi',
          'catatanPembuka',
          'waktuBuka',
          'waktuTutup',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'kodeMataKuliah',
          'namaPraktikum',
          'topikMateri',
          'kelas',
          'labId',
          'ruangLab',
          'hari',
          'jamMulai',
          'jamSelesai',
          'namaAsisten',
          'asistenId',
          'status',
          'statusSesi',
          'catatanPembuka',
          'waktuBuka',
          'waktuTutup',
          'daftarPeserta',
          'gracePeriodMinutes',
          'lateFineAmount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.kodeMataKuliah is string &&
        data.namaPraktikum is string &&
        data.topikMateri is string &&
        data.kelas is string &&
        data.labId is string &&
        data.ruangLab is string &&
        data.hari is string &&
        data.jamMulai is string &&
        data.jamSelesai is string &&
        data.namaAsisten is string &&
        data.asistenId is string &&
        data.status in ['open', 'closed'] &&
        data.statusSesi in ['DITUTUP', 'DIBUKA', 'SELESAI'] &&
        ((data.status == 'open' && data.statusSesi == 'DIBUKA') ||
          (data.status == 'closed' && data.statusSesi in ['DITUTUP', 'SELESAI'])) &&
        data.catatanPembuka is string &&
        (data.waktuBuka == null || data.waktuBuka is timestamp) &&
        (data.waktuTutup == null || data.waktuTutup is timestamp) &&
        data.get('daftarPeserta', []) is list &&
        data.get('gracePeriodMinutes', 15) is number &&
        data.get('gracePeriodMinutes', 15) >= 0 &&
        data.get('lateFineAmount', 10000) is number &&
        data.get('lateFineAmount', 10000) >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validSessionTransition(before, after) {
      return (
        (before.status == 'closed' && before.statusSesi == 'DITUTUP' &&
          ((after.status == 'closed' && after.statusSesi == 'DITUTUP') ||
           (after.status == 'open' && after.statusSesi == 'DIBUKA'))) ||
        (before.status == 'open' && before.statusSesi == 'DIBUKA' &&
          ((after.status == 'open' && after.statusSesi == 'DIBUKA') ||
           (after.status == 'closed' && after.statusSesi == 'SELESAI')))
      );
    }

    function validAttendanceCreate(attendanceId) {
      let attendance = request.resource.data;
      let session = get(
        /databases/$(database)/documents/sessions/$(attendance.sessionId)
      ).data;
      let lab = get(
        /databases/$(database)/documents/labs/$(session.labId)
      ).data;
      let calculatedDistance = attendance.location.distance(lab.location);
      let punctualityFields = ['isLate', 'lateMinutes', 'attendancePunctuality'];
      let hasPunctuality = attendance.keys().hasAll(punctualityFields);
      let hasAnyPunctuality = attendance.keys().hasAny(punctualityFields);

      return attendance.keys().hasAll([
          'id',
          'sessionId',
          'namaPraktikum',
          'topikMateri',
          'studentId',
          'studentName',
          'studentNim',
          'studentClass',
          'statusKehadiran',
          'catatan',
          'timestamp',
          'waktuPresensi',
          'tanggal',
          'labId',
          'location',
          'locationAccuracyMeters',
          'distanceMeters',
          'locationCapturedAt'
        ]) &&
        attendance.keys().hasOnly([
          'id',
          'sessionId',
          'namaPraktikum',
          'topikMateri',
          'studentId',
          'studentName',
          'studentNim',
          'studentClass',
          'statusKehadiran',
          'catatan',
          'timestamp',
          'waktuPresensi',
          'tanggal',
          'labId',
          'location',
          'locationAccuracyMeters',
          'distanceMeters',
          'locationCapturedAt',
          'isLate',
          'lateMinutes',
          'attendancePunctuality'
        ]) &&
        attendance.id == attendanceId &&
        attendanceId == attendance.sessionId + '_' + request.auth.uid &&
        attendance.studentId == request.auth.uid &&
        attendance.sessionId is string &&
        attendance.labId is string &&
        attendance.location is latlng &&
        attendance.locationAccuracyMeters is number &&
        attendance.locationAccuracyMeters >= 0 &&
        attendance.locationAccuracyMeters <= 50 &&
        attendance.distanceMeters is number &&
        attendance.locationCapturedAt is timestamp &&
        attendance.timestamp == request.time &&
        attendance.locationCapturedAt <= request.time &&
        attendance.locationCapturedAt >= request.time - duration.value(5, 'm') &&
        attendance.statusKehadiran == 'HADIR' &&
        attendance.studentName == getUserData().nama &&
        attendance.studentNim == getUserData().nomorInduk &&
        attendance.studentClass == getUserData().kelas &&
        attendance.studentClass == session.kelas &&
        attendance.namaPraktikum is string &&
        attendance.topikMateri is string &&
        attendance.catatan is string &&
        attendance.waktuPresensi is string &&
        attendance.tanggal is string &&
        session.labId == attendance.labId &&
        session.status == 'open' &&
        session.statusSesi == 'DIBUKA' &&
        lab.isActive == true &&
        lab.location is latlng &&
        lab.radiusMeters is number &&
        calculatedDistance <= lab.radiusMeters &&
        math.abs(attendance.distanceMeters - calculatedDistance) <= 2 &&
        (!hasAnyPunctuality || (
          hasPunctuality &&
          attendance.isLate is bool &&
          attendance.lateMinutes is number &&
          attendance.lateMinutes >= 0 &&
          attendance.attendancePunctuality in ['ON_TIME', 'LATE'] &&
          ((attendance.isLate == true && attendance.lateMinutes > 0 && attendance.attendancePunctuality == 'LATE') ||
           (attendance.isLate == false && attendance.lateMinutes == 0 && attendance.attendancePunctuality == 'ON_TIME'))
        ));
    }

    function validLeaveCreate(requestId) {
      let leaveRequest = request.resource.data;
      let session = get(
        /databases/$(database)/documents/sessions/$(leaveRequest.sessionId)
      ).data;

      return leaveRequest.keys().hasAll([
          'studentId',
          'studentName',
          'studentNim',
          'sessionId',
          'sessionName',
          'reason',
          'aiCategory',
          'aiStatus',
          'aiExperimental',
          'aiScoreType',
          'status',
          'reviewedBy',
          'reviewedByUid',
          'reviewedAt',
          'createdAt'
        ]) &&
        leaveRequest.keys().hasOnly([
          'studentId',
          'studentName',
          'studentNim',
          'sessionId',
          'sessionName',
          'reason',
          'aiCategory',
          'aiStatus',
          'aiExperimental',
          'aiScoreType',
          'status',
          'reviewedBy',
          'reviewedByUid',
          'reviewedAt',
          'createdAt'
        ]) &&
        requestId == leaveRequest.sessionId + '_' + request.auth.uid &&
        leaveRequest.studentId == request.auth.uid &&
        leaveRequest.studentName == getUserData().nama &&
        leaveRequest.studentNim == getUserData().nomorInduk &&
        leaveRequest.sessionId is string &&
        leaveRequest.sessionName is string &&
        leaveRequest.reason is string &&
        leaveRequest.reason.size() >= 10 &&
        leaveRequest.reason.size() <= 1000 &&
        (leaveRequest.aiCategory == null || leaveRequest.aiCategory is string) &&
        leaveRequest.aiStatus is string &&
        leaveRequest.aiExperimental is bool &&
        (leaveRequest.aiScoreType == null || leaveRequest.aiScoreType is string) &&
        leaveRequest.status == 'pending' &&
        leaveRequest.reviewedBy == null &&
        leaveRequest.reviewedByUid == null &&
        leaveRequest.reviewedAt == null &&
        leaveRequest.createdAt == request.time &&
        session.status == 'open' &&
        session.statusSesi == 'DIBUKA' &&
        session.kelas == getUserData().kelas;
    }

    function validFineCreate(fineId) {
      let fine = request.resource.data;
      let attendancePath = /databases/$(database)/documents/attendances/$(fine.attendanceId);
      let sessionPath = /databases/$(database)/documents/sessions/$(fine.sessionId);
      let leavePath = /databases/$(database)/documents/leave_requests/$(fineId);
      let attendance = get(attendancePath).data;
      let session = get(sessionPath).data;

      return fine.keys().hasAll([
          'id',
          'attendanceId',
          'sessionId',
          'sessionName',
          'labId',
          'labName',
          'studentId',
          'studentName',
          'studentNim',
          'studentClass',
          'lateMinutes',
          'gracePeriodMinutes',
          'amount',
          'paymentStatus',
          'latestOrderId',
          'latestInvoiceId',
          'latestInvoiceUrl',
          'paidAt',
          'createdAt',
          'updatedAt'
        ]) &&
        fine.keys().hasOnly([
          'id',
          'attendanceId',
          'sessionId',
          'sessionName',
          'labId',
          'labName',
          'studentId',
          'studentName',
          'studentNim',
          'studentClass',
          'lateMinutes',
          'gracePeriodMinutes',
          'amount',
          'paymentStatus',
          'latestOrderId',
          'latestInvoiceId',
          'latestInvoiceUrl',
          'paidAt',
          'createdAt',
          'updatedAt'
        ]) &&
        exists(attendancePath) &&
        exists(sessionPath) &&
        fine.id == fineId &&
        fine.attendanceId == fineId &&
        fineId == fine.sessionId + '_' + request.auth.uid &&
        fine.studentId == request.auth.uid &&
        fine.studentName == getUserData().nama &&
        fine.studentNim == getUserData().nomorInduk &&
        fine.studentClass == getUserData().kelas &&
        fine.sessionName is string &&
        fine.labId == session.labId &&
        fine.labName is string &&
        fine.lateMinutes is number &&
        fine.lateMinutes > 0 &&
        fine.lateMinutes == attendance.get('lateMinutes', 0) &&
        fine.gracePeriodMinutes == session.get('gracePeriodMinutes', 15) &&
        fine.amount is number &&
        fine.amount > 0 &&
        fine.amount == session.get('lateFineAmount', 10000) &&
        attendance.studentId == request.auth.uid &&
        attendance.get('isLate', false) == true &&
        attendance.get('attendancePunctuality', '') == 'LATE' &&
        fine.paymentStatus == 'pending' &&
        fine.latestOrderId == null &&
        fine.latestInvoiceId == null &&
        fine.latestInvoiceUrl == null &&
        fine.paidAt == null &&
        fine.createdAt == request.time &&
        fine.updatedAt == request.time &&
        (!exists(leavePath) || get(leavePath).data.status != 'approved');
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        validUserData(request.resource.data, userId) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'praktikan' &&
        request.resource.data.roles == ['praktikan'] &&
        request.resource.data.get('assignedLabIds', []) == [] &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId) &&
        validUserData(request.resource.data, userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.nomorInduk == resource.data.nomorInduk &&
        request.resource.data.get('kelas', null) == resource.data.get('kelas', null) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.roles == resource.data.roles &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data.get('assignedLabIds', []) == resource.data.get('assignedLabIds', []) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'updatedAt']);

      allow delete: if false;
    }

    match /labs/{labId} {
      allow read: if isActiveUser();

      allow create: if isAslab() &&
        validLabData(request.resource.data) &&
        validNewLabData(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAslab() &&
        validLabData(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'code',
          'courseCode',
          'courseName',
          'location',
          'radiusMeters',
          'gracePeriodMinutes',
          'lateFineAmount',
          'address',
          'aslabId',
          'asprakIds',
          'asprakMembers',
          'studentIds',
          'studentMembers',
          'isActive',
          'updatedAt',
          'updatedBy'
        ]);

      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isActiveUser();

      allow create: if canManageSessionLab(request.resource.data.labId) &&
        validSessionData(request.resource.data) &&
        request.resource.data.asistenId == request.auth.uid &&
        request.resource.data.status == 'closed' &&
        request.resource.data.statusSesi == 'DITUTUP' &&
        request.resource.data.waktuBuka == null &&
        request.resource.data.waktuTutup == null &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        labExistsAndActive(request.resource.data.labId);

      allow update: if canManageSessionLab(request.resource.data.labId) &&
        resource.data.asistenId == request.auth.uid &&
        request.resource.data.asistenId == resource.data.asistenId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        validSessionData(request.resource.data) &&
        validSessionTransition(resource.data, request.resource.data) &&
        labExistsAndActive(request.resource.data.labId);

      allow delete: if resource.data.asistenId == request.auth.uid &&
        canManageSessionLab(resource.data.labId);
    }

    match /attendances/{attendanceId} {
      allow read: if isActiveUser() && (
        resource.data.get('studentId', '') == request.auth.uid ||
        isAsisten() ||
        isAslab()
      );

      allow create: if isPraktikan() && validAttendanceCreate(attendanceId);

      allow update, delete: if false;
    }

    match /leave_requests/{requestId} {
      allow read: if isActiveUser() && (
        resource.data.studentId == request.auth.uid ||
        isAsisten()
      );

      allow create: if isPraktikan() && validLeaveCreate(requestId);

      allow update: if isAsisten() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewedBy == getUserData().nama &&
        request.resource.data.reviewedByUid == request.auth.uid &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy', 'reviewedByUid', 'reviewedAt']);

      allow delete: if false;
    }

    match /fines/{fineId} {
      allow read: if isActiveUser() && (
        resource.data.studentId == request.auth.uid ||
        isAslab() ||
        isAsisten()
      );

      allow create: if isPraktikan() && validFineCreate(fineId);

      allow update, delete: if false;
    }

    match /payment_transactions/{txId} {
      allow read: if isActiveUser() && (
        resource.data.studentId == request.auth.uid ||
        isAslab()
      );

      allow create, update, delete: if false;
    }
  }
}
